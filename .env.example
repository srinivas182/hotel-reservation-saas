# ---------------------------------------------------------------------
# Hotel Reservation SaaS — environment template
# Copy to .env and run `php artisan key:generate`.
# Defaults below match the Docker Compose stack (`make up`).
# Never commit a real .env file or production secrets.
# ---------------------------------------------------------------------

APP_NAME="Hotel Reservation SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4 LTS (Docker service "mysql")
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hotel_saas
DB_USERNAME=hotel_saas
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=hotel_saas_cache_

# Redis 7 (Docker service "redis")
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

HORIZON_PREFIX=hotel_saas_horizon:

# /health is disabled until a token is set (use a long random string).
HEALTH_CHECK_TOKEN=

# Content Security Policy: report-only until violation reports are clean.
CSP_ENFORCE=false

# Checks new passwords against known data breaches (Have I Been Pwned).
CHECK_BREACHED_PASSWORDS=true

# Mailpit (Docker service "mailpit", UI on http://localhost:8025)
# "platform" sends through the providers set up in platform admin (with failover,
# logging and usage); until one is enabled it uses MAIL_FALLBACK_MAILER.
MAIL_MAILER=platform
MAIL_FALLBACK_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
