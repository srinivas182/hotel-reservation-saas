# Caddy terminates HTTPS with automatic Let's Encrypt certificates.
# APP_DOMAIN and ACME_EMAIL come from the server's .env file.
{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip

    reverse_proxy nginx:80 {
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output stdout
        format json
    }
}
