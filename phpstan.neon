includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8

    tmpDir: storage/phpstan

    ignoreErrors:
        # BelongsToHotel is applied by hotel-owned models from S1 onwards; it is
        # exercised by the tenancy test suite through a fixture model.
        -
            identifier: trait.unused
            path: app/Domains/Tenancy/Concerns/BelongsToHotel.php
